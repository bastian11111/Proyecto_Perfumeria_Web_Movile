# Copia este archivo como ".env" y ajusta los valores.

# Local: mongodb://127.0.0.1:27017   |   Atlas: mongodb+srv://usuario:clave@cluster.mongodb.net
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=perfumeria

# Cambia esto por un texto largo y secreto
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio

PUERTO=3001

# true solo si MongoDB corre como replica set (Atlas lo es por defecto).
# En un MongoDB local normal (standalone) dejar en false.
USAR_TRANSACCIONES=false
